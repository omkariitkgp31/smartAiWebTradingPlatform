APP_ENV=development
SERVER_PORT=8080
SERVER_READ_TIMEOUT_SECONDS=10
SERVER_WRITE_TIMEOUT_SECONDS=10

DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=15

JWT_SECRET=replace_with_a_random_32_char_or_longer_secret_value
JWT_ISSUER=open-soft-auth
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_HOURS=168

OTP_HASH_PEPPER=replace_with_another_random_secret
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_VERIFICATION_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_15_MINUTES=10
OTP_CLEANUP_INTERVAL_MINUTES=2

GLOBAL_RATE_LIMIT_RPS=5
GLOBAL_RATE_LIMIT_BURST=20

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=your_email@gmail.com
SMTP_MOCK=true
